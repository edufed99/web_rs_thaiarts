# Node / Next.js
.worktrees/
node_modules/
.next/
.next-dev/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Env / secrets
.env
.env.local
.env.*.local
client_secret_*.json
backend/data/secrets/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / Windows
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/
System Volume Information/

# Editor
.vscode/
.idea/
*.swp

# Python venvs (never commit)
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Misc
.cache/
.tmp/
coverage/

# Skip the heavy venv inside old code
old code/4.recommendation/.venv_iaes/

# Research PDFs (not needed in repo)
*.pdf
old code/**/*.pdf

# Model artifacts (binary, large, regenerated by pipelines/)
artifacts/*.npz
artifacts/*.parquet
artifacts/*.bin
artifacts/*.pkl
artifacts/*.joblib
artifacts/*.txt
!artifacts/.gitkeep

# Backend coverage reports
backend/coverage/
backend/.coverage
backend/htmlcov/
backend/.pytest_cache/

# Root-level coverage report (created by pytest at repo root when
# ``--cov`` is run from the project root, not just inside backend/).
.coverage

# User-uploaded media lives outside ``artifacts/`` so the offline
# recommender pipeline re-runs don't wipe it. Never commit it.
backend/data/

# Ephemeral debug dumps left in the repo root during smoke tests.
cascade_dump.txt
facets.json
test.png
tmp/
output/
public key/
**/.next*

# Playwright artifacts
frontend/test-results/
frontend/playwright-report/
