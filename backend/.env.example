# backend/.env.example — copy to backend/.env and fill in real values.
# This file is tracked. The real .env is gitignored.

# --- Postgres (live data + admin slice) -------------------------------
# Set RECSYS_DB_ENABLED=1 to opt into Postgres. Default is 0 (CSV-only).
# When off, /admin/* endpoints still work but write to the in-memory
# loader only — nothing persists across restarts.
RECSYS_DB_ENABLED=1
# RECSYS_DB_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/web_rs_thaiarts

# --- Auth (Phase G) ----------------------------------------------------
# HS256 JWT secret. MUST be ≥32 bytes for production; rotate before
# any real deployment. The default ("change-me-please-use-32-bytes")
# in app/core/config.py is fine for local dev with no admin.
# RECSYS_JWT_SECRET=replace-with-32-byte-random-string

# Comma-separated allow-list for the first-user-admin bootstrap.
# When this list is empty, the very first POST /auth/signup becomes
# admin. When non-empty (the dev default), only listed usernames
# are auto-promoted to admin on signup.
RECSYS_ADMIN_USERNAMES=admin

# --- CORS (frontend ↔ backend) -----------------------------------------
# Comma-separated origins. Next.js dev server defaults to 3000.
RECSYS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Grounding (admin ingest, Phase F-G) -------------------------------
# RECSYS_GROUNDING_USE_LLM=1 enables the optional Layer B Gemini call
# inside /admin/items/draft. Default is 0 (rule-only Layer A).
# RECSYS_GROUNDING_USE_LLM=0
# RECSYS_GEMINI_API_KEY=replace-with-gemini-key

# --- E5 (admin ingest embeddings, Phase F) -----------------------------
# RECSYS_E5_ENABLED=1 (default) loads intfloat/multilingual-e5-large-
# instruct on first ingest. Set 0 to skip (synthetic embeddings,
# useful only for tests). First ingest triggers a ~2.5 GB HuggingFace
# download; set RECSYS_E5_LOCAL_PATH to preload from a local snapshot.
# RECSYS_E5_ENABLED=1
# RECSYS_E5_LOCAL_PATH=/path/to/local/snapshot
# RECSYS_E5_MODEL_NAME=intfloat/multilingual-e5-large-instruct