# backend/.env.example — copy to backend/.env and fill in real values.
# This file is tracked. The real .env is gitignored.
#
# Since issue #10 the backend is the Private Model Service only: it is
# database-free and serves no public routes. The public FastAPI
# application, its auth/admin/upload settings, and the Alembic layer were
# retired with it.

# --- Internal Service Credential ---------------------------------------
# Required. The Next.js Application Backend must present the same value as
# `Authorization: Bearer <secret>` on every call. An empty value disables
# the private contract (503) instead of weakening auth.
RECSYS_INTERNAL_SERVICE_SECRET=replace-with-a-long-random-secret

# --- Artifacts ---------------------------------------------------------
# Where the offline pipeline output lives. Defaults to <repo>/artifacts.
# RECSYS_ARTIFACT_DIR=../artifacts

# --- Serving config (override artifact manifest) -----------------------
# RECSYS_HYBRID_ALPHA=0.7
# RECSYS_CBF_KEYWORD_BOOST=0.05
# RECSYS_ITEMKNN_K=10
# RECSYS_ITEMKNN_SHRINK=50.0
# RECSYS_POSITIVE_THRESHOLD=4
# RECSYS_NEGATIVE_PENALTY_ALPHA=1.0
# RECSYS_MIN_CANDS=10
# RECSYS_MAX_CANDS=

# --- E5 runtime --------------------------------------------------------
# RECSYS_E5_ENABLED=1 (default) loads intfloat/multilingual-e5-large-
# instruct on demand. Set 0 to skip (synthetic embeddings, useful only
# for tests). The first real load triggers a ~2.5 GB HuggingFace
# download; set RECSYS_E5_LOCAL_PATH to preload from a local snapshot.
# RECSYS_PRELOAD_E5=0
# RECSYS_E5_LOCAL_PATH=/path/to/local/snapshot
# RECSYS_E5_MODEL_NAME=intfloat/multilingual-e5-large-instruct
