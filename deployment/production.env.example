# Production Environment Variables (.env) for Thai Arts Recommender
# Place this file as .env alongside docker-compose.yml on the server.

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=web_rs_thaiarts

# Application Secrets & Admin
RECSYS_JWT_SECRET=GENERATE_RANDOM_LONG_SECRET_KEY
RECSYS_ADMIN_USERNAMES=admin

# URLs & CORS
RECSYS_FRONTEND_BASE_URL=http://thaiperform.fed.bpi.ac.th
RECSYS_CORS_ORIGINS=http://thaiperform.fed.bpi.ac.th,http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://thaiperform.fed.bpi.ac.th/api

# Recommender Runtime Flags
RECSYS_DB_ENABLED=1
RECSYS_E5_ENABLED=0
RECSYS_PRELOAD_E5=0
RECSYS_GROUNDING_USE_LLM=0
RECSYS_ANALYTICS_USE_LLM=0

# Optional External Integrations (Fill if needed)
# RECSYS_GEMINI_API_KEY=
# RECSYS_SMTP_HOST=smtp.gmail.com
# RECSYS_SMTP_PORT=587
# RECSYS_SMTP_USERNAME=
# RECSYS_SMTP_PASSWORD=
# RECSYS_SMTP_FROM_EMAIL=
# RECSYS_SMTP_USE_TLS=1
