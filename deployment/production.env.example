# Production Environment Variables (.env) for Thai Arts Recommender
# Place this file as .env alongside docker-compose.yml on the server.
#
# Since issue #10 the Next.js Application Backend is the only public API
# surface. The FastAPI container is the Private Model Service: it is not
# exposed by the host reverse proxy and never receives browser traffic.
#
# Since issue #11 the model service does NOT load this file: the compose
# definition passes it only the RECSYS_* variables it declares explicitly,
# so POSTGRES_* credentials never reach the model container. This file
# still supplies the compose interpolation values (MODEL_SERVICE_SHARED_SECRET,
# POSTGRES_*) and the frontend/migrate services' env_file.

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=web_rs_thaiarts

# Private Model Service — shared secret between the Next.js Application
# Backend and the model process. Must be a strong, independently generated
# value; an empty secret disables the private contract (503).
MODEL_SERVICE_SHARED_SECRET=GENERATE_RANDOM_LONG_SECRET_KEY

# Recommender Runtime Flags (Private Model Service + Application Backend)
RECSYS_E5_ENABLED=0
RECSYS_PRELOAD_E5=0

# --- Member Google Login (Next.js; google_login_client.json) ---------------
# REQUIRED in production. If GOOGLE_LOGIN_REDIRECT_URI or FRONTEND_BASE_URL is
# left at the http://localhost:3000 default, Google login silently redirects
# members back to localhost and the flow breaks. The redirect URI below MUST
# also be registered in Google Cloud Console (Authorized redirect URIs) for the
# member-login OAuth client, and it must be https (Google rejects http for web
# clients). Do NOT rely on the dev frontend/.env: it is excluded from the
# production image by frontend/.dockerignore, so these must come from here.
GOOGLE_LOGIN_CLIENT_FILE=/app/data/secrets/google_login_client.json
# GOOGLE_LOGIN_CLIENT_ID=
# GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=https://thaiperform.fed.bpi.ac.th/api/auth/google/login/callback
GOOGLE_LOGIN_STATE_TTL_SECONDS=600

# --- Admin Gmail sender (Next.js; google_oauth_client.json) ----------------
# REQUIRED when using Gmail for password-reset email. The redirect URI must be
# registered in Google Cloud Console for the admin Gmail OAuth client.
GMAIL_OAUTH_CLIENT_FILE=/app/data/secrets/google_oauth_client.json
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_OAUTH_REDIRECT_URI=https://thaiperform.fed.bpi.ac.th/api/admin/gmail-oauth/callback
GMAIL_OAUTH_TOKEN_FILE=/app/data/secrets/gmail_oauth_token.json
GMAIL_SENDER_EMAIL=dpatt148@gmail.com

# --- SMTP fallback + password reset (Next.js) ------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_USE_TLS=1

# --- Public origin + cookies (Next.js) -------------------------------------
# REQUIRED in production. FRONTEND_BASE_URL is the public HTTPS origin used to
# build the post-login redirect and password-reset links; leaving it at
# http://localhost:3000 sends members to localhost after login. Set
# SESSION_COOKIE_SECURE=1 behind HTTPS (nginx terminates TLS). OAUTH_STATE_SECRET
# signs the PKCE state cookies for both Google flows — replace the placeholder
# with a long random value (it is NOT persisted data; rotating it only
# invalidates in-flight OAuth cookies).
FRONTEND_BASE_URL=https://thaiperform.fed.bpi.ac.th
SESSION_COOKIE_SECURE=1
PASSWORD_RESET_TOKEN_MINUTES=30
OAUTH_STATE_SECRET=GENERATE_RANDOM_LONG_SECRET_KEY
