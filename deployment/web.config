<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <directoryBrowse enabled="false" />

        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="115343360" />
                <verbs allowUnlisted="true">
                    <add verb="TRACE" allowed="false" />
                </verbs>
            </requestFiltering>
        </security>

        <rewrite>
            <rules>
                <rule name="AcmeChallenge" stopProcessing="true">
                    <match url="^\.well-known/acme-challenge/.*" />
                    <action type="None" />
                </rule>

                <rule name="Redirect to HTTPS" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^OFF$" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
                </rule>

                <!-- Issue #10: the Next.js Application Backend owns the entire
                     public API surface. FastAPI is now only the Private Model
                     Service, which IIS never exposes — nothing routes to 8001. -->
                <rule name="ThaiArtsRecommender-API" stopProcessing="true">
                    <match url="^api/(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:3000/{R:0}" />
                </rule>

                <rule name="ThaiArtsRecommender-Health" stopProcessing="true">
                    <match url="^health$" />
                    <action type="Rewrite" url="http://127.0.0.1:3000/api/health" />
                </rule>

                <rule name="ThaiArtsRecommender-Frontend" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
                </rule>
            </rules>
        </rewrite>

        <httpErrors errorMode="DetailedLocalOnly" />
    </system.webServer>
</configuration>
