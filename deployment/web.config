<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- PHASE 9 Security Hardening: Disable Directory Browsing -->
        <directoryBrowse enabled="false" />

        <!-- PHASE 9 Request Filtering Rules -->
        <security>
            <requestFiltering>
                <!-- Set maxAllowedContentLength to exactly 115343360 bytes (110MB) -->
                <requestLimits maxAllowedContentLength="115343360" />
                <!-- Disable HTTP TRACE verb -->
                <verbs allowUnlisted="true">
                    <add verb="TRACE" allowed="false" />
                </verbs>
            </requestFiltering>
        </security>

        <!-- Reverse Proxy & HTTPS Enforcement URL Rewrite Rules -->
        <rewrite>
            <rules>
                <!-- 1. Let's Encrypt / ACME Challenge bypass (Must stay HTTP on port 80) -->
                <rule name="AcmeChallenge" stopProcessing="true">
                    <match url="^\.well-known/acme-challenge/.*" />
                    <action type="None" />
                </rule>

                <!-- 2. Enforce HTTPS: Redirect all other HTTP traffic to HTTPS -->
                <rule name="Redirect to HTTPS" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^OFF$" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
                </rule>

                <!-- 3. Public API Route: /api/* -> Next.js on 127.0.0.1:3000/api/* -->
                <rule name="ThaiArtsRecommender-Public-API" stopProcessing="true">
                    <match url="^api/(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:3000/api/{R:1}" />
                </rule>

                <!-- 4. Convenience Health Route: /health -> Next.js /api/health -->
                <rule name="ThaiArtsRecommender-Health" stopProcessing="true">
                    <match url="^health$" />
                    <action type="Rewrite" url="http://127.0.0.1:3000/api/health" />
                </rule>

                <!-- 5. Frontend Route: /* -> 127.0.0.1:3000/* -->
                <rule name="ThaiArtsRecommender-Frontend" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
                </rule>
            </rules>
        </rewrite>

        <httpErrors errorMode="DetailedLocalOnly" />
    </system.webServer>
</configuration>
