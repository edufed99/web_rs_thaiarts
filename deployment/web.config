<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <directoryBrowse enabled="false" />

        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="115343360" />
                <verbs allowUnlisted="true">
                    <add verb="TRACE" allowed="false" />
                </verbs>
            </requestFiltering>
        </security>

        <rewrite>
            <rules>
                <rule name="AcmeChallenge" stopProcessing="true">
                    <match url="^\.well-known/acme-challenge/.*" />
                    <action type="None" />
                </rule>

                <rule name="Redirect to HTTPS" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^OFF$" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
                </rule>

                <!-- Staged migration: only routes implemented by the Next.js
                     Application Backend bypass FastAPI. This rule must remain
                     before the broad compatibility rule below. -->
                <rule name="ThaiArtsRecommender-Next-Catalogue-API" stopProcessing="true">
                    <match url="^api/(contexts|keywords|items|items/batch|items/[0-9]+|items/[0-9]+/similar|uploads/(items|avatars)(/.*)?)$" />
                    <action type="Rewrite" url="http://127.0.0.1:3000/{R:0}" />
                </rule>

                <!-- Unmigrated public APIs retain staged FastAPI compatibility. -->
                <rule name="ThaiArtsRecommender-Backend-API" stopProcessing="true">
                    <match url="^api/(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:8001/{R:1}" />
                </rule>

                <rule name="ThaiArtsRecommender-Backend-Health" stopProcessing="true">
                    <match url="^health$" />
                    <action type="Rewrite" url="http://127.0.0.1:8001/health" />
                </rule>

                <rule name="ThaiArtsRecommender-Frontend" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
                </rule>
            </rules>
        </rewrite>

        <httpErrors errorMode="DetailedLocalOnly" />
    </system.webServer>
</configuration>
