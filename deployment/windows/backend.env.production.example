# Copy to backend/.env. Do not commit or redistribute the completed file.

# Private Model Service (issue #10): database-free artifact scorer. The
# public FastAPI application was retired; the Next.js Application Backend
# is the only public API surface and owns the PostgreSQL schema.
RECSYS_DB_ENABLED=0
RECSYS_ARTIFACT_DIR=../artifacts

# Setup-App.ps1 replaces this value with a random secret in backend/.env.
# The SAME value must be set as MODEL_SERVICE_SHARED_SECRET in
# frontend/.env.production so the Application Backend can authenticate.
RECSYS_INTERNAL_SERVICE_SECRET=<GENERATED_DURING_SETUP>

# Disable optional network/model integrations until their production secrets and policy are approved.
RECSYS_E5_ENABLED=0
RECSYS_PRELOAD_E5=0
