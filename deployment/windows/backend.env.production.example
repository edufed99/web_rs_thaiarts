# Copy to backend/.env. Do not commit or redistribute the completed file.

# Start safely in artifacts-only mode. Change to 1 only after PostgreSQL is ready.
RECSYS_DB_ENABLED=0
# RECSYS_DATABASE_URL=postgresql+psycopg://APP_USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/web_rs_thaiarts

# Setup-App.ps1 replaces this value with a random secret in backend/.env.
RECSYS_JWT_SECRET=<GENERATED_DURING_SETUP>
RECSYS_ADMIN_USERNAMES=CHANGE_TO_APPROVED_ADMIN_USERNAME

RECSYS_FRONTEND_BASE_URL=http://127.0.0.1:3000
RECSYS_CORS_ORIGINS=http://127.0.0.1:3000

# Disable optional network/model integrations until their production secrets and policy are approved.
RECSYS_E5_ENABLED=0
RECSYS_PRELOAD_E5=0
RECSYS_GROUNDING_USE_LLM=0
RECSYS_ANALYTICS_USE_LLM=0

# Optional production integrations. Keep secrets out of the ZIP.
# RECSYS_SMTP_HOST=smtp.example.org
# RECSYS_SMTP_PORT=587
# RECSYS_SMTP_USERNAME=
# RECSYS_SMTP_PASSWORD=
# RECSYS_SMTP_FROM_EMAIL=
# RECSYS_SMTP_USE_TLS=1
# RECSYS_GOOGLE_LOGIN_CLIENT_ID=
# RECSYS_GOOGLE_LOGIN_CLIENT_SECRET=
# RECSYS_GOOGLE_LOGIN_REDIRECT_URI=https://YOUR-DOMAIN/api/auth/google/login/callback
# RECSYS_GMAIL_OAUTH_CLIENT_ID=
# RECSYS_GMAIL_OAUTH_CLIENT_SECRET=
# RECSYS_GMAIL_OAUTH_REFRESH_TOKEN=
# RECSYS_GMAIL_OAUTH_REDIRECT_URI=https://YOUR-DOMAIN/api/auth/google/callback
# RECSYS_GMAIL_SENDER_EMAIL=
# RECSYS_GEMINI_API_KEY=

