# Server-only settings for the Next.js Application Backend (issue #10).
# The browser talks only to the same-origin /api surface — there is no
# NEXT_PUBLIC_* API base URL anymore. Rebuild after changing this file.

# PostgreSQL schema owned by the Application Backend (TypeORM migrations).
DATABASE_URL=postgresql+psycopg://APP_USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/web_rs_thaiarts

# The Private Model Service (FastAPI) address + Internal Service Credential.
# The secret must equal RECSYS_INTERNAL_SERVICE_SECRET in backend/.env.
PRIVATE_MODEL_SERVICE_URL=http://127.0.0.1:8001
MODEL_SERVICE_SHARED_SECRET=<GENERATED_DURING_SETUP>

# Local HTTP development only. Production defaults to secure cookies.
SESSION_COOKIE_SECURE=0
