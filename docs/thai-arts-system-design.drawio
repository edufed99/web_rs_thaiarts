  <diagram id="recommendation-page" name="04 Recommendation Flow">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="r0"/>
        <mxCell id="r1" parent="r0"/>
        <mxCell id="r-title" value="Recommendation Process — Eligibility-Gated Hybrid Recommender" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="r1"><mxGeometry x="290" y="25" width="1020" height="50" as="geometry"/></mxCell>
        <mxCell id="r-input1" value="บริบทของงาน&lt;br&gt;เช่น งานแต่งงาน งานบุญ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2F6B9A;fontSize=16;" vertex="1" parent="r1"><mxGeometry x="90" y="140" width="260" height="85" as="geometry"/></mxCell>
        <mxCell id="r-input2" value="คำสำคัญและตัวกรอง&lt;br&gt;เช่น ภาค ประเภท ผู้แสดง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2F6B9A;fontSize=16;" vertex="1" parent="r1"><mxGeometry x="90" y="280" width="260" height="85" as="geometry"/></mxCell>
        <mxCell id="r-input3" value="ประวัติสมาชิก&lt;br&gt;Like / Save / Rating / View" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4C8C4A;fontSize=16;" vertex="1" parent="r1"><mxGeometry x="90" y="420" width="260" height="85" as="geometry"/></mxCell>
        <mxCell id="r-assemble" value="&lt;b&gt;Next.js Recommendation Orchestrator&lt;/b&gt;&lt;br&gt;ตรวจคำขอ ระบุตัวผู้ใช้ และประกอบข้อมูล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C58A18;strokeWidth=2;fontSize=17;" vertex="1" parent="r1"><mxGeometry x="460" y="250" width="360" height="130" as="geometry"/></mxCell>
        <mxCell id="r-gate" value="&lt;b&gt;Eligibility Gate&lt;/b&gt;&lt;br&gt;คัดเฉพาะรายการที่เหมาะสม&lt;br&gt;และแปลงเป็น Artifact Item ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8D6;strokeColor=#D97706;strokeWidth=2;fontSize=17;" vertex="1" parent="r1"><mxGeometry x="930" y="250" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="r-cbf" value="&lt;b&gt;CBF&lt;/b&gt;&lt;br&gt;ความคล้ายคลึงจากเนื้อหา&lt;br&gt;Embedding + Keyword Boost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E57C2;strokeWidth=2;fontSize=16;" vertex="1" parent="r1"><mxGeometry x="780" y="500" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="r-cf" value="&lt;b&gt;CF ItemKNN&lt;/b&gt;&lt;br&gt;ความคล้ายคลึงจากพฤติกรรม&lt;br&gt;และคะแนนของผู้ใช้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E57C2;strokeWidth=2;fontSize=16;" vertex="1" parent="r1"><mxGeometry x="1170" y="500" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="r-hybrid" value="&lt;b&gt;Hybrid WeightedSum&lt;/b&gt;&lt;br&gt;รวมคะแนน CBF + CF&lt;br&gt;และหักผลจากคะแนนเชิงลบ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#6D4EC2;strokeWidth=3;fontSize=17;" vertex="1" parent="r1"><mxGeometry x="970" y="690" width="330" height="125" as="geometry"/></mxCell>
        <mxCell id="r-ok" value="โมเดลตอบสำเร็จ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6A84B;strokeWidth=2;fontSize=16;" vertex="1" parent="r1"><mxGeometry x="530" y="690" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="r-fallback" value="&lt;b&gt;Fallback Recommendation&lt;/b&gt;&lt;br&gt;ใช้ความนิยมและข้อมูลแค็ตตาล็อก&lt;br&gt;พร้อมระบุว่าไม่ใช่ผลเฉพาะบุคคล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#B84A4A;strokeWidth=2;fontSize=16;" vertex="1" parent="r1"><mxGeometry x="120" y="675" width="310" height="140" as="geometry"/></mxCell>
        <mxCell id="r-enrich" value="&lt;b&gt;Catalogue Enrichment&lt;/b&gt;&lt;br&gt;เติมชื่อ รายละเอียด รูปภาพ สถานะสมาชิก&lt;br&gt;คำอธิบายภาษาไทย และบันทึก Analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4C8C4A;strokeWidth=2;fontSize=16;" vertex="1" parent="r1"><mxGeometry x="590" y="860" width="460" height="105" as="geometry"/></mxCell>
        <mxCell id="r-result" value="ผลคำแนะนำ Top-K&lt;br&gt;แสดงในหน้า Results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF7EE;strokeColor=#2D8A65;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="1160" y="860" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="r-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="r1" source="r-input1" target="r-assemble"><mxGeometry relative="1" as="geometry"/></mxCell>
