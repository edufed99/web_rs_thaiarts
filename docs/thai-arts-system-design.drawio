  <diagram id="context-page" name="01 System Context">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="c0"/>
        <mxCell id="c1" parent="c0"/>
        <mxCell id="c-title" value="System Context — ระบบแนะนำศิลปะและการแสดงไทย" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="c1">
          <mxGeometry x="330" y="30" width="940" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c-visitor" value="ผู้เยี่ยมชม&#xa;ค้นหาและขอคำแนะนำ" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=16;fontColor=#1F2937;" vertex="1" parent="c1">
          <mxGeometry x="90" y="150" width="110" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="c-member" value="สมาชิก&#xa;จัดการโปรไฟล์และกิจกรรม" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=16;fontColor=#1F2937;" vertex="1" parent="c1">
          <mxGeometry x="90" y="365" width="110" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="c-admin" value="ผู้ดูแลระบบ&#xa;บริหารข้อมูลและติดตามผล" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=16;fontColor=#1F2937;" vertex="1" parent="c1">
          <mxGeometry x="90" y="580" width="110" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="c-system" value="&lt;b&gt;Thai Arts Recommender&lt;/b&gt;&lt;br&gt;&lt;br&gt;เว็บแอปพลิเคชันสำหรับค้นหา&lt;br&gt;และแนะนำศิลปะ/การแสดงไทย&lt;br&gt;&lt;br&gt;• แค็ตตาล็อกและสื่อ&lt;br&gt;• คำแนะนำแบบ Hybrid&lt;br&gt;• บัญชีสมาชิกและกิจกรรม&lt;br&gt;• การบริหารและวิเคราะห์ผล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2F6B9A;strokeWidth=3;fontSize=18;fontColor=#16324F;spacing=16;" vertex="1" parent="c1">
          <mxGeometry x="510" y="190" width="510" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="c-google" value="&lt;b&gt;Google Identity&lt;/b&gt;&lt;br&gt;เข้าสู่ระบบด้วย Google" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E57C2;strokeWidth=2;fontSize=17;fontColor=#3C2463;" vertex="1" parent="c1">
          <mxGeometry x="1230" y="190" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="c-gmail" value="&lt;b&gt;Gmail / Email Service&lt;/b&gt;&lt;br&gt;ส่งอีเมลและรีเซ็ตรหัสผ่าน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E57C2;strokeWidth=2;fontSize=17;fontColor=#3C2463;" vertex="1" parent="c1">
          <mxGeometry x="1230" y="380" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="c-researcher" value="ผู้ดูแลโมเดล&#xa;สร้าง Artifact แบบออฟไลน์" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=16;fontColor=#1F2937;" vertex="1" parent="c1">
          <mxGeometry x="1300" y="610" width="130" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="c-e1" value="เรียกดูและขอคำแนะนำ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="c1" source="c-visitor" target="c-system"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e2" value="ใช้งานเฉพาะบุคคล" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="c1" source="c-member" target="c-system"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e3" value="บริหารระบบ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="c1" source="c-admin" target="c-system"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e4" value="OAuth / OpenID Connect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#7E57C2;" edge="1" parent="c1" source="c-system" target="c-google"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e5" value="ส่งอีเมล" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#7E57C2;" edge="1" parent="c1" source="c-system" target="c-gmail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e6" value="เผยแพร่ Artifact" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#B7791F;" edge="1" parent="c1" source="c-researcher" target="c-system"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-note" value="ขอบเขตสาธารณะ: ผู้ใช้ติดต่อระบบผ่านเว็บแอปเท่านั้น&#xa;บริการโมเดลและฐานข้อมูลไม่เปิดให้ Browser ติดต่อโดยตรง" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6A84B;fontSize=15;fontColor=#5F4313;spacing=10;" vertex="1" parent="c1">
          <mxGeometry x="500" y="700" width="530" height="100" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
