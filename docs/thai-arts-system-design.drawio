  <diagram id="container-page" name="02 Container Architecture">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="a0"/>
        <mxCell id="a1" parent="a0"/>
        <mxCell id="a-title" value="Container Architecture — โครงสร้างบริการที่ทำงานร่วมกัน" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="a1"><mxGeometry x="300" y="25" width="1000" height="50" as="geometry"/></mxCell>
        <mxCell id="a-public-zone" value="Public Zone" style="swimlane;horizontal=0;startSize=34;rounded=1;html=1;fillColor=#F5FAFF;strokeColor=#88B5D8;fontSize=16;fontStyle=1;" vertex="1" parent="a1"><mxGeometry x="40" y="100" width="430" height="690" as="geometry"/></mxCell>
        <mxCell id="a-private-zone" value="Private Application Network" style="swimlane;horizontal=0;startSize=34;rounded=1;html=1;fillColor=#F8FBF6;strokeColor=#83AF73;fontSize=16;fontStyle=1;" vertex="1" parent="a1"><mxGeometry x="500" y="100" width="1050" height="690" as="geometry"/></mxCell>
        <mxCell id="a-browser" value="&lt;b&gt;Web Browser&lt;/b&gt;&lt;br&gt;ผู้เยี่ยมชม / สมาชิก / ผู้ดูแล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2F6B9A;strokeWidth=2;fontSize=17;" vertex="1" parent="a1"><mxGeometry x="100" y="210" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="a-nginx" value="&lt;b&gt;Nginx / HTTPS&lt;/b&gt;&lt;br&gt;Reverse proxy และ TLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2F6B9A;strokeWidth=2;fontSize=17;" vertex="1" parent="a1"><mxGeometry x="100" y="450" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="a-next" value="&lt;b&gt;Next.js Application&lt;/b&gt;&lt;br&gt;หน้าเว็บ + Public API&lt;br&gt;Auth, Catalogue, Member, Admin,&lt;br&gt;Analytics และ Recommendation Orchestration&lt;br&gt;&lt;b&gt;Port 3000&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C58A18;strokeWidth=3;fontSize=17;spacing=10;" vertex="1" parent="a1"><mxGeometry x="570" y="180" width="400" height="190" as="geometry"/></mxCell>
        <mxCell id="a-db" value="&lt;b&gt;PostgreSQL 18&lt;/b&gt;&lt;br&gt;สมาชิก เซสชัน แค็ตตาล็อก&lt;br&gt;กิจกรรม และข้อมูลวิเคราะห์" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E8F5E9;strokeColor=#4C8C4A;strokeWidth=2;fontSize=16;" vertex="1" parent="a1"><mxGeometry x="1080" y="160" width="270" height="150" as="geometry"/></mxCell>
        <mxCell id="a-upload" value="&lt;b&gt;Uploads Storage&lt;/b&gt;&lt;br&gt;รูปภาพ วิดีโอ และ Avatar" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4C8C4A;strokeWidth=2;fontSize=16;" vertex="1" parent="a1"><mxGeometry x="1080" y="340" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="a-model" value="&lt;b&gt;FastAPI Private Model Service&lt;/b&gt;&lt;br&gt;/internal/v1/health&lt;br&gt;/internal/v1/inference&lt;br&gt;/internal/v1/similarity&lt;br&gt;&lt;b&gt;Port 8001 — ภายในเท่านั้น&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E57C2;strokeWidth=3;fontSize=16;spacing=10;" vertex="1" parent="a1"><mxGeometry x="570" y="510" width="400" height="180" as="geometry"/></mxCell>
        <mxCell id="a-artifacts" value="&lt;b&gt;Model Artifacts&lt;/b&gt;&lt;br&gt;Embeddings, CF Indices,&lt;br&gt;Catalog และ Model Config" style="shape=folder;tabWidth=80;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#F3E8FF;strokeColor=#7E57C2;strokeWidth=2;fontSize=16;" vertex="1" parent="a1"><mxGeometry x="1080" y="540" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="a-pipeline" value="&lt;b&gt;Offline Pipeline&lt;/b&gt;&lt;br&gt;Train / Generate / Evaluate&lt;br&gt;ไม่ทำงานระหว่าง Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E5;strokeColor=#D97706;strokeWidth=2;fontSize=16;dashed=1;" vertex="1" parent="a1"><mxGeometry x="1080" y="700" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="a-e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="a1" source="a-browser" target="a-nginx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e2" value="ทุกหน้าและ /api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="a1" source="a-nginx" target="a-next"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e3" value="TypeORM / pg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#4C8C4A;" edge="1" parent="a1" source="a-next" target="a-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e4" value="อ่าน/เขียนสื่อ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#4C8C4A;" edge="1" parent="a1" source="a-next" target="a-upload"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e5" value="Bearer Internal Credential" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#7E57C2;" edge="1" parent="a1" source="a-next" target="a-model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e6" value="โหลดครั้งเดียวตอนเริ่มระบบ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#7E57C2;" edge="1" parent="a1" source="a-artifacts" target="a-model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e7" value="สร้าง/ปรับปรุง" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#D97706;" edge="1" parent="a1" source="a-pipeline" target="a-artifacts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-warning" value="Browser ไม่ติดต่อ PostgreSQL หรือ FastAPI โดยตรง" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6A84B;fontSize=15;fontStyle=1;" vertex="1" parent="a1"><mxGeometry x="70" y="650" width="360" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

