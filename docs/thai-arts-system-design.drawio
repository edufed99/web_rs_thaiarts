        <mxCell id="d-legend" value="เส้นทึบ = ความสัมพันธ์ด้วยรหัสข้อมูล&#xa;เส้นประ = ความสัมพันธ์เชิงตรรกะผ่าน user_key หรือสถานะการเผยแพร่" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=13;" vertex="1" parent="d1"><mxGeometry x="1450" y="1090" width="420" height="90" as="geometry"/></mxCell>

