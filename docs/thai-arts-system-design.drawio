        <mxCell id="r-e11" value="สำเร็จ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#2D8A65;" edge="1" parent="r1" source="r-ok" target="r-enrich"><mxGeometry relative="1" as="geometry"/></mxCell>
