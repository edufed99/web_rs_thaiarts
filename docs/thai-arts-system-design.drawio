        <mxCell id="d-userkey-note" value="user_key VARCHAR(150)&lt;br&gt;รองรับทั้ง anon:&amp;lt;uuid&amp;gt; และสมาชิก" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6A84B;fontSize=14;" vertex="1" parent="d1"><mxGeometry x="1090" y="820" width="220" height="100" as="geometry"/></mxCell>

