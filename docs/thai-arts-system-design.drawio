  <diagram id="evaluation-page" name="08 Evaluation Framework">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="e0"/>
        <mxCell id="e1" parent="e0"/>
        <mxCell id="e-title" value="Evaluation Framework — กรอบการประเมินความเหมาะสมของระบบโดยผู้เชี่ยวชาญ" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="e1"><mxGeometry x="320" y="25" width="1160" height="50" as="geometry"/></mxCell>

        <mxCell id="e-evidence-title" value="1. หลักฐานประกอบการประเมิน" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="e1"><mxGeometry x="60" y="100" width="450" height="40" as="geometry"/></mxCell>
        <mxCell id="e-ev1" value="&lt;b&gt;โครงสร้างระบบ&lt;/b&gt;&lt;br&gt;System Context&lt;br&gt;Container Architecture&lt;br&gt;ER Diagram" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2F6B9A;strokeWidth=2;fontSize=16;spacing=10;" vertex="1" parent="e1"><mxGeometry x="60" y="160" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="e-ev2" value="&lt;b&gt;ฟังก์ชันและกระบวนการ&lt;/b&gt;&lt;br&gt;Use Cases&lt;br&gt;Recommendation Flow&lt;br&gt;User Activity Flows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4C8C4A;strokeWidth=2;fontSize=16;spacing=10;" vertex="1" parent="e1"><mxGeometry x="330" y="160" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="e-ev3" value="&lt;b&gt;การใช้งานจริง&lt;/b&gt;&lt;br&gt;Sitemap และหน้าจอ&lt;br&gt;ระบบหรือวิดีโอสาธิต&lt;br&gt;คู่มือฉบับร่าง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C58A18;strokeWidth=2;fontSize=16;spacing=10;" vertex="1" parent="e1"><mxGeometry x="610" y="160" width="250" height="150" as="geometry"/></mxCell>

        <mxCell id="e-review" value="&lt;b&gt;ผู้เชี่ยวชาญทดลองและพิจารณาระบบ&lt;/b&gt;&lt;br&gt;ตรวจเอกสาร → ทดลองภารกิจหลัก → บันทึกผล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E57C2;strokeWidth=3;fontSize=18;spacing=10;" vertex="1" parent="e1"><mxGeometry x="1000" y="175" width="480" height="120" as="geometry"/></mxCell>

        <mxCell id="e-dim-title" value="2. มิติการประเมิน" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="e1"><mxGeometry x="620" y="370" width="560" height="40" as="geometry"/></mxCell>
        <mxCell id="e-d1" value="&lt;b&gt;ด้านที่ 1&lt;/b&gt;&lt;br&gt;การออกแบบและ&lt;br&gt;สถาปัตยกรรมระบบ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2F6B9A;fontSize=16;" vertex="1" parent="e1"><mxGeometry x="80" y="450" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="e-d2" value="&lt;b&gt;ด้านที่ 2&lt;/b&gt;&lt;br&gt;ความถูกต้องและครบถ้วน&lt;br&gt;ของฟังก์ชัน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4C8C4A;fontSize=16;" vertex="1" parent="e1"><mxGeometry x="360" y="450" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="e-d3" value="&lt;b&gt;ด้านที่ 3&lt;/b&gt;&lt;br&gt;ความเหมาะสมของ&lt;br&gt;ระบบแนะนำ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E57C2;fontSize=16;" vertex="1" parent="e1"><mxGeometry x="640" y="450" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="e-d4" value="&lt;b&gt;ด้านที่ 4&lt;/b&gt;&lt;br&gt;ส่วนติดต่อและ&lt;br&gt;ความสะดวกในการใช้งาน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C58A18;fontSize=16;" vertex="1" parent="e1"><mxGeometry x="920" y="450" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="e-d5" value="&lt;b&gt;ด้านที่ 5&lt;/b&gt;&lt;br&gt;ข้อมูล ความปลอดภัย&lt;br&gt;และความเป็นส่วนตัว" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#B84A4A;fontSize=16;" vertex="1" parent="e1"><mxGeometry x="1200" y="450" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="e-d6" value="&lt;b&gt;ด้านที่ 6&lt;/b&gt;&lt;br&gt;คู่มือการใช้งานและ&lt;br&gt;ความเหมาะสมโดยรวม" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF7EE;strokeColor=#2D8A65;fontSize=16;" vertex="1" parent="e1"><mxGeometry x="1480" y="450" width="240" height="115" as="geometry"/></mxCell>

        <mxCell id="e-form" value="&lt;b&gt;3. เครื่องมือประเมิน&lt;/b&gt;&lt;br&gt;มาตรประมาณค่า 5 ระดับ&lt;br&gt;5 มากที่สุด · 4 มาก · 3 ปานกลาง · 2 น้อย · 1 น้อยที่สุด&lt;br&gt;พร้อมคำถามปลายเปิดและข้อเสนอแนะ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6A84B;strokeWidth=2;fontSize=17;spacing=12;" vertex="1" parent="e1"><mxGeometry x="220" y="660" width="580" height="150" as="geometry"/></mxCell>
        <mxCell id="e-analysis" value="&lt;b&gt;4. การวิเคราะห์ผล&lt;/b&gt;&lt;br&gt;ตรวจความครบถ้วนของแบบประเมิน&lt;br&gt;สรุปค่าเฉลี่ยและการกระจายของคะแนน&lt;br&gt;จัดหมวดหมู่ข้อเสนอแนะเชิงคุณภาพ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E57C2;strokeWidth=2;fontSize=17;spacing=12;" vertex="1" parent="e1"><mxGeometry x="990" y="660" width="520" height="150" as="geometry"/></mxCell>
        <mxCell id="e-decision" value="ผลอยู่ในระดับเหมาะสม&lt;br&gt;และไม่มีประเด็นวิกฤต?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6A84B;strokeWidth=2;fontSize=16;" vertex="1" parent="e1"><mxGeometry x="780" y="870" width="250" height="145" as="geometry"/></mxCell>
        <mxCell id="e-improve" value="ปรับปรุงระบบ Diagram&lt;br&gt;แบบประเมิน หรือคู่มือ&lt;br&gt;แล้วประเมินซ้ำ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#B84A4A;strokeWidth=2;fontSize=16;" vertex="1" parent="e1"><mxGeometry x="350" y="895" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="e-accept" value="&lt;b&gt;รับรองความเหมาะสมของระบบ&lt;/b&gt;&lt;br&gt;สรุปผลและนำข้อเสนอแนะไปใช้&lt;br&gt;ในระบบและคู่มือฉบับสมบูรณ์" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF7EE;strokeColor=#2D8A65;strokeWidth=3;fontSize=17;" vertex="1" parent="e1"><mxGeometry x="1190" y="890" width="390" height="115" as="geometry"/></mxCell>

        <mxCell id="e-edge1" value="ส่งมอบหลักฐาน" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="e1" source="e-ev2" target="e-review"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-edge2" value="ประเมิน 6 ด้าน" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#7E57C2;" edge="1" parent="e1" source="e-review" target="e-d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-edge3" value="ให้คะแนนและข้อเสนอแนะ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#D6A84B;" edge="1" parent="e1" source="e-d3" target="e-form"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-edge4" value="รวบรวมข้อมูล" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#7E57C2;" edge="1" parent="e1" source="e-form" target="e-analysis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-edge5" value="พิจารณาเกณฑ์" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="e1" source="e-analysis" target="e-decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-edge6" value="ไม่ผ่าน" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#B84A4A;" edge="1" parent="e1" source="e-decision" target="e-improve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-edge7" value="ประเมินซ้ำ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#B84A4A;" edge="1" parent="e1" source="e-improve" target="e-review"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-edge8" value="ผ่าน" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#2D8A65;" edge="1" parent="e1" source="e-decision" target="e-accept"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-note" value="หลักการสำคัญ: ผู้เชี่ยวชาญควรประเมินจาก Diagram + ระบบจริง/วิดีโอสาธิต + คู่มือฉบับร่าง ไม่ใช่จาก Diagram เพียงอย่างเดียว" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=14;fontStyle=1;" vertex="1" parent="e1"><mxGeometry x="80" y="1015" width="660" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
