        <mxCell id="r-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4C8C4A;" edge="1" parent="r1" source="r-input3" target="r-assemble"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-e4" value="Candidate Set" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="r1" source="r-assemble" target="r-gate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-e5" value="Eligible IDs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#7E57C2;" edge="1" parent="r1" source="r-gate" target="r-cbf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-e6" value="Eligible IDs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#7E57C2;" edge="1" parent="r1" source="r-gate" target="r-cf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-e7" value="CBF Score" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#7E57C2;" edge="1" parent="r1" source="r-cbf" target="r-hybrid"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-e8" value="CF Score" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;strokeColor=#7E57C2;" edge="1" parent="r1" source="r-cf" target="r-hybrid"><mxGeometry relative="1" as="geometry"/></mxCell>
