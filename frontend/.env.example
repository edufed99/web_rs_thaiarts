# Copy to .env.local and adjust for your environment.
# Server-only settings. Never prefix these values with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/web_rs_thaiarts
MODEL_SERVICE_URL=http://127.0.0.1:8001
COMPATIBILITY_SERVICE_URL=http://127.0.0.1:8001
MEDIA_STORE_ROOT=./data/uploads
PRIVATE_MODEL_SERVICE_URL=http://127.0.0.1:8002
MODEL_SERVICE_SHARED_SECRET=replace-with-a-long-random-secret
# Local HTTP development only. Production defaults to secure cookies.
SESSION_COOKIE_SECURE=0

# --- Member Google Login (OpenID Connect; google_login_client.json) ---------
# The redirect URI below must be registered in Google Cloud Console and match
# GOOGLE_LOGIN_REDIRECT_URI exactly. Google terminates the member flow in
# Next.js at this callback path.
GOOGLE_LOGIN_CLIENT_FILE=./data/secrets/google_login_client.json
# GOOGLE_LOGIN_CLIENT_ID=
# GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/google/login/callback
GOOGLE_LOGIN_STATE_TTL_SECONDS=600
# Overrides for tests/mirrors (defaults are Google's production endpoints).
# GOOGLE_LOGIN_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_LOGIN_TOKEN_URI=https://oauth2.googleapis.com/token
# GOOGLE_LOGIN_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

# --- Admin Gmail sender OAuth (google_oauth_client.json) --------------------
# Redirect URI must be registered in Google Cloud Console. This is the
# separate admin-only callback; it never shares the member login client.
GMAIL_OAUTH_CLIENT_FILE=./data/secrets/google_oauth_client.json
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/admin/gmail-oauth/callback
GMAIL_OAUTH_TOKEN_FILE=./data/secrets/gmail_oauth_token.json
GMAIL_SENDER_EMAIL=dpatt148@gmail.com
# GMAIL_OAUTH_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# GMAIL_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token

# --- SMTP fallback for password-reset email ---------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_USE_TLS=1

# --- Password reset ----------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_MINUTES=30

# --- OAuth state cookies -----------------------------------------------------
# HMAC secret that signs the PKCE state/verifier cookies for both Google
# flows. Override with a long random value in every deployed environment.
OAUTH_STATE_SECRET=replace-with-a-long-random-secret
