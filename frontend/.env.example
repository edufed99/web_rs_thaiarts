# Copy to .env.local and adjust for your environment.
# Server-only settings. Never prefix these values with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/web_rs_thaiarts
MODEL_SERVICE_URL=http://127.0.0.1:8001
COMPATIBILITY_SERVICE_URL=http://127.0.0.1:8001
MEDIA_STORE_ROOT=./data/uploads
PRIVATE_MODEL_SERVICE_URL=http://127.0.0.1:8002
MODEL_SERVICE_SHARED_SECRET=replace-with-a-long-random-secret
# Per-attempt inference timeout in ms (default 5000, bounds 100-30000).
# Inference is retried once; persistent failure returns the identified fallback.
MODEL_SERVICE_TIMEOUT_MS=5000
# Optional eligibility-gate caps (mirrors the legacy RECSYS_* settings).
# Empty RECSYS_MAX_CANDS means no cap; RECSYS_MIN_CANDS is the adaptive fill floor.
RECSYS_MAX_CANDS=
RECSYS_MIN_CANDS=10
# Local HTTP development only. Production defaults to secure cookies.
SESSION_COOKIE_SECURE=0
